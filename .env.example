# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://vrwuskfihlhpjrrlzfqc.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Gemini API
GEMINI_API_KEY=your-gemini-api-key
# (선택) 단순 분류/판단용(Lite). 기본: gemini-2.5-flash-lite — classifyLogsAsTask, detectRelation
# GEMINI_MODEL_LITE=gemini-2.5-flash-lite
# (선택) 품질용(Flash). 기본: gemini-2.5-flash — parseLog, summarizeForExecutive, generateDailyReport, answerQuery
# GEMINI_MODEL_FLASH=gemini-2.5-flash
# (선택) 임베딩 모델. 기본: gemini-embedding-001. 자연어 검색용이라 채팅 모델과 별도.
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# App URL (배포 후)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 임시: 인증 없이 실행 (true 시 로그인/리다이렉트 비활성화)
NEXT_PUBLIC_AUTH_BYPASS=true
# Bypass 시 사용할 사용자 ID. 얻는 방법:
# 1) 브라우저에서 http://localhost:3000/api/dev/create-bypass-user 접속 → userId 복사 후 아래에 붙여넣기
# 2) Supabase 대시보드 → Authentication → Users → 테이블의 "User UID" 열에서 UUID 복사
AUTH_BYPASS_USER_ID=

# MCP 커넥터 (claude.ai에서 /api/mcp/<MCP_SECRET> 으로 연결)
# 24자 이상 임의 문자열. 생성 예: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
MCP_SECRET=
# 커넥터가 읽고 쓸 사용자 UUID (Supabase → Authentication → Users)
MCP_USER_ID=
